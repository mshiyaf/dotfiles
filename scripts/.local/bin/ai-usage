#!/usr/bin/env bun

import { execFileSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";

type Row = {
  agent: string;
  account: string;
  limit: string;
  used: number | null;
  resetAt: number | null;
  note?: string;
};

const home = os.homedir();
const timeoutMs = 10_000;

function readJson(file: string): any | null {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return null;
  }
}

function writeJson(file: string, value: unknown) {
  const temporary = `${file}.tmp`;
  fs.writeFileSync(temporary, JSON.stringify(value, null, 2), { mode: 0o600 });
  fs.renameSync(temporary, file);
}

function jwtExpiresSoon(token: string, expiresAt = 0): boolean {
  if (expiresAt) return expiresAt <= Date.now() + 60_000;
  try {
    const payload = JSON.parse(Buffer.from(token.split(".")[1]!, "base64url").toString("utf8"));
    return typeof payload.exp !== "number" || payload.exp * 1000 <= Date.now() + 60_000;
  } catch {
    return true;
  }
}

async function getJson(url: string, headers: Record<string, string>): Promise<any> {
  const signal = AbortSignal.timeout(timeoutMs);
  const response = await fetch(url, { headers, signal });
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
  return await response.json();
}

function epoch(value: unknown): number | null {
  if (typeof value === "number") return value > 10_000_000_000 ? value : value * 1000;
  if (typeof value !== "string" || !value) return null;
  const parsed = Date.parse(value);
  return Number.isNaN(parsed) ? null : parsed;
}

function percent(value: unknown): number | null {
  const parsed = typeof value === "number" ? value : Number(value);
  return Number.isFinite(parsed) ? Math.max(0, Math.min(100, parsed)) : null;
}

function duration(ms: number): string {
  const minutes = Math.max(0, Math.ceil(ms / 60_000));
  const days = Math.floor(minutes / 1440);
  const hours = Math.floor((minutes % 1440) / 60);
  const mins = minutes % 60;
  if (days) return `${days}d ${hours}h`;
  if (hours) return `${hours}h ${mins}m`;
  return `${mins}m`;
}

function resetText(resetAt: number | null): string {
  if (!resetAt) return "-";
  const date = new Date(resetAt);
  const absolute = date.toLocaleString("en-GB", {
    day: "2-digit",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  });
  return `${absolute} (${duration(resetAt - Date.now())})`;
}

function windowLabel(seconds: unknown, fallback: string): string {
  const value = Number(seconds);
  if (!Number.isFinite(value) || value <= 0) return fallback;
  if (value % 86400 === 0) return `${value / 86400}d`;
  if (value % 3600 === 0) return `${value / 3600}h`;
  return fallback;
}

async function codexRows(): Promise<Row[]> {
  const profilesDir = path.join(home, ".local/share/opencode/openai-accounts");
  const files = fs.existsSync(profilesDir)
    ? fs.readdirSync(profilesDir).filter((name) => name.endsWith(".json")).sort()
    : [];
  const fallback = path.join(home, ".codex/auth.json");
  const profiles = files.map((name) => ({
    name: path.basename(name, ".json"),
    file: path.join(profilesDir, name),
    auth: readJson(path.join(profilesDir, name)),
    kind: "opencode",
  }));
  if (!profiles.length && fs.existsSync(fallback)) {
    profiles.push({ name: "default", file: fallback, auth: readJson(fallback), kind: "codex" });
  }

  const results = await Promise.all(profiles.map(async ({ name, file, auth, kind }) => {
    let token = kind === "codex" ? auth?.tokens?.access_token : auth?.access;
    let refreshToken = kind === "codex" ? auth?.tokens?.refresh_token : auth?.refresh;
    const accountId = kind === "codex" ? auth?.tokens?.account_id : auth?.accountId;
    if (!token || !accountId) return [{ agent: "Codex", account: name, limit: "-", used: null, resetAt: null, note: "not logged in" }];
    try {
      if (refreshToken && jwtExpiresSoon(token, kind === "opencode" ? auth?.expires : 0)) {
        const response = await fetch("https://auth.openai.com/oauth/token", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams({
            grant_type: "refresh_token",
            refresh_token: refreshToken,
            client_id: "app_EMoamEEZ73f0CkXaXp7hrann",
          }),
          signal: AbortSignal.timeout(timeoutMs),
        });
        if (!response.ok) throw new Error(`token refresh HTTP ${response.status}`);
        const refreshed: any = await response.json();
        token = refreshed.access_token;
        refreshToken = refreshed.refresh_token ?? refreshToken;
        if (kind === "codex") {
          auth.tokens = { ...auth.tokens, access_token: token, refresh_token: refreshToken, id_token: refreshed.id_token ?? auth.tokens.id_token };
          auth.last_refresh = new Date().toISOString();
        } else {
          auth = { ...auth, access: token, refresh: refreshToken, expires: Date.now() + Number(refreshed.expires_in ?? 0) * 1000 };
        }
        writeJson(file, auth);
      }
      const data = await getJson("https://chatgpt.com/backend-api/wham/usage", {
        Authorization: `Bearer ${token}`,
        "chatgpt-account-id": accountId,
        "OpenAI-Beta": "responses=experimental",
        originator: "codex_cli_rs",
        accept: "application/json",
      });
      const windows = [data.rate_limit?.secondary_window, data.rate_limit?.primary_window].filter(Boolean);
      if (!windows.length) return [{ agent: "Codex", account: name, limit: "-", used: null, resetAt: null, note: data.plan_type ?? "no limits returned" }];
      return windows.map((window: any) => ({
        agent: "Codex",
        account: name,
        limit: windowLabel(window.limit_window_seconds, "quota"),
        used: percent(window.used_percent),
        resetAt: epoch(window.reset_at) ?? (window.reset_after_seconds ? Date.now() + Number(window.reset_after_seconds) * 1000 : null),
        note: data.plan_type,
      }));
    } catch (error) {
      return [{ agent: "Codex", account: name, limit: "-", used: null, resetAt: null, note: (error as Error).message }];
    }
  }));
  return results.flat();
}

async function claudeRows(): Promise<Row[]> {
  const auth = readJson(path.join(home, ".claude/.credentials.json"))?.claudeAiOauth;
  if (!auth?.accessToken) return [{ agent: "Claude", account: "default", limit: "-", used: null, resetAt: null, note: "not logged in" }];
  try {
    const data = await getJson("https://api.anthropic.com/api/oauth/usage", {
      Authorization: `Bearer ${auth.accessToken}`,
      "anthropic-beta": "oauth-2025-04-20",
      accept: "application/json",
    });
    const limits: Array<[string, any]> = [
      ["5h", data.five_hour],
      ["7d", data.seven_day],
      ["7d Opus", data.seven_day_opus],
      ["7d Sonnet", data.seven_day_sonnet],
    ];
    return limits.filter(([, value]) => value).map(([label, value]) => ({
      agent: "Claude",
      account: "default",
      limit: label,
      used: percent(value.utilization),
      resetAt: epoch(value.resets_at),
      note: auth.subscriptionType,
    }));
  } catch (error) {
    return [{ agent: "Claude", account: "default", limit: "-", used: null, resetAt: null, note: `${(error as Error).message}; run claude /login` }];
  }
}

async function kimiRows(): Promise<Row[]> {
  const file = path.join(home, ".kimi-code/credentials/kimi-code.json");
  let auth = readJson(file);
  if (!auth?.access_token) return [{ agent: "Kimi", account: "default", limit: "-", used: null, resetAt: null, note: "not logged in" }];
  try {
    if (auth.refresh_token && Number(auth.expires_at) * 1000 <= Date.now() + 60_000) {
      const response = await fetch("https://auth.kimi.com/api/oauth/token", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
          client_id: "17e5f671-d194-4dfb-9706-5516cb48c098",
          grant_type: "refresh_token",
          refresh_token: auth.refresh_token,
        }),
        signal: AbortSignal.timeout(timeoutMs),
      });
      if (!response.ok) throw new Error(`token refresh HTTP ${response.status}`);
      const refreshed: any = await response.json();
      auth = {
        ...auth,
        ...refreshed,
        refresh_token: refreshed.refresh_token ?? auth.refresh_token,
        expires_at: Math.floor(Date.now() / 1000) + Number(refreshed.expires_in ?? 0),
      };
      writeJson(file, auth);
    }
    const data = await getJson("https://api.kimi.com/coding/v1/usages", {
      Authorization: `Bearer ${auth.access_token}`,
      accept: "application/json",
    });
    const rows: Row[] = [];
    const add = (label: string, value: any) => {
      const used = Number(value?.used);
      const cap = Number(value?.limit);
      rows.push({
        agent: "Kimi",
        account: "default",
        limit: label,
        used: Number.isFinite(used) && Number.isFinite(cap) && cap > 0 ? percent(used / cap * 100) : null,
        resetAt: epoch(value?.resetTime ?? value?.reset_at),
        note: data.user?.membership?.level?.replace(/^LEVEL_/, "").toLowerCase(),
      });
    };
    if (data.usage) add("7d", data.usage);
    for (const item of data.limits ?? []) {
      const window = item.window ?? {};
      const seconds = Number(window.duration) * (String(window.timeUnit).includes("MINUTE") ? 60 : String(window.timeUnit).includes("HOUR") ? 3600 : 86400);
      add(windowLabel(seconds, "quota"), item.detail ?? item);
    }
    return rows.length ? rows : [{ agent: "Kimi", account: "default", limit: "-", used: null, resetAt: null, note: "no limits returned" }];
  } catch (error) {
    return [{ agent: "Kimi", account: "default", limit: "-", used: null, resetAt: null, note: `${(error as Error).message}; run kimi login` }];
  }
}

async function commandCodeRows(): Promise<Row[]> {
  const auth = readJson(path.join(home, ".commandcode/auth.json"));
  if (!auth?.apiKey) return [{ agent: "CommandCode", account: "default", limit: "-", used: null, resetAt: null, note: "not logged in" }];
  try {
    const data = await getJson("https://api.commandcode.ai/alpha/billing/credits", {
      Authorization: `Bearer ${auth.apiKey}`,
      "Content-Type": "application/json",
      "User-Agent": "command-code-cli",
      "x-command-code-cli-version": "ai-usage",
      "x-command-code-cli-environment": "production",
    });
    const limits = data.windowLimits;
    const rows: Row[] = [];
    for (const [label, value] of [["5h", limits?.fiveHour], ["7d", limits?.weekly]] as Array<[string, any]>) {
      if (!value) continue;
      rows.push({
        agent: "CommandCode",
        account: auth.userName ?? "default",
        limit: label,
        used: value.cap > 0 ? percent(value.used / value.cap * 100) : null,
        resetAt: epoch(value.resetAt),
        note: `$${Number(data.credits?.monthlyCredits ?? 0).toFixed(2)} credits`,
      });
    }
    return rows.length ? rows : [{ agent: "CommandCode", account: auth.userName ?? "default", limit: "monthly", used: null, resetAt: null, note: `$${Number(data.credits?.monthlyCredits ?? 0).toFixed(2)} credits` }];
  } catch (error) {
    return [{ agent: "CommandCode", account: auth.userName ?? "default", limit: "-", used: null, resetAt: null, note: (error as Error).message }];
  }
}

async function ampRows(): Promise<Row[]> {
  try {
    const output = execFileSync("amp", ["usage"], { encoding: "utf8", timeout: timeoutMs });
    const account = output.match(/Signed in as\s+([^\s]+)/)?.[1] ?? "default";
    const rows: Row[] = [];
    const daily = output.match(/Amp Free:\s+(\d+)% remaining today/);
    if (daily) rows.push({
      agent: "Amp",
      account,
      limit: "daily",
      used: 100 - Number(daily[1]),
      resetAt: null,
      note: "resets daily",
    });
    const subscription = output.match(/Subscription\s+([^:]+):\s+(\d+)% other usage and (\d+)% orb usage remaining\s+-\s+(.+)/);
    if (subscription) {
      rows.push({ agent: "Amp", account, limit: "subscription", used: 100 - Number(subscription[2]), resetAt: null, note: `${subscription[1]}; ${subscription[4]}` });
      rows.push({ agent: "Amp", account, limit: "orbs", used: 100 - Number(subscription[3]), resetAt: null, note: subscription[4] });
    }
    const credits = output.match(/Individual credits:\s+\$([\d.]+) remaining/);
    if (credits) rows.push({ agent: "Amp", account, limit: "credits", used: null, resetAt: null, note: `$${credits[1]} left` });
    return rows.length ? rows : [{ agent: "Amp", account, limit: "-", used: null, resetAt: null, note: "no usage returned" }];
  } catch (error) {
    return [{ agent: "Amp", account: "default", limit: "-", used: null, resetAt: null, note: (error as Error).message }];
  }
}

function agyPorts(): number[] {
  try {
    const output = execFileSync("ss", ["-ltnp"], { encoding: "utf8", timeout: 2_000 });
    const ports = [...output.matchAll(/127\.0\.0\.1:(\d+).*users:\(\(\"agy\"/g)].map((match) => Number(match[1]));
    return [...new Set(ports)];
  } catch {
    return [];
  }
}

async function antigravityRows(): Promise<Row[]> {
  const body = JSON.stringify({ metadata: { ideName: "antigravity", extensionName: "antigravity", locale: "en" } });
  let data: any = null;
  let quotaSummary: any = null;
  for (const port of agyPorts()) {
    for (const scheme of ["http", "https"]) {
      try {
        const response = await fetch(`${scheme}://127.0.0.1:${port}/exa.language_server_pb.LanguageServerService/GetUserStatus`, {
          method: "POST",
          headers: { "Content-Type": "application/json", "Connect-Protocol-Version": "1" },
          body,
          signal: AbortSignal.timeout(1_500),
          ...(scheme === "https" ? { tls: { rejectUnauthorized: false } } as any : {}),
        } as any);
        if (response.ok) {
          data = await response.json();
          const quotaResponse = await fetch(`${scheme}://127.0.0.1:${port}/exa.language_server_pb.LanguageServerService/RetrieveUserQuotaSummary`, {
            method: "POST",
            headers: { "Content-Type": "application/json", "Connect-Protocol-Version": "1" },
            body: JSON.stringify({ forceRefresh: true }),
            signal: AbortSignal.timeout(5_000),
            ...(scheme === "https" ? { tls: { rejectUnauthorized: false } } as any : {}),
          } as any);
          if (quotaResponse.ok) quotaSummary = await quotaResponse.json();
        }
      } catch {}
      if (data) break;
    }
    if (data) break;
  }
  if (!data) return [{ agent: "Antigravity", account: "default", limit: "models", used: null, resetAt: null, note: "open agy, then rerun" }];

  const status = data.userStatus ?? {};
  const groups = quotaSummary?.response?.groups ?? [];
  if (groups.length) {
    return groups.flatMap((group: any) => {
      const groupName = String(group.displayName ?? "models")
        .replace(/ models$/i, "")
        .replace(/ and /gi, " + ");
      return (group.buckets ?? []).map((bucket: any) => ({
        agent: "Antigravity",
        account: status.email ?? "default",
        limit: `${groupName} ${bucket.window === "weekly" ? "7d" : bucket.window ?? "quota"}`,
        used: typeof bucket.remainingFraction === "number" ? percent((1 - bucket.remainingFraction) * 100) : null,
        resetAt: epoch(bucket.resetTime),
        note: status.planStatus?.planInfo?.planName,
      }));
    });
  }

  const configs = status.cascadeModelConfigData?.clientModelConfigs ?? [];
  const grouped = new Map<string, { labels: string[]; left: number; resetAt: number | null }>();
  for (const config of configs) {
    const quota = config.quotaInfo;
    if (!quota || typeof quota.remainingFraction !== "number") continue;
    const left = Math.round(quota.remainingFraction * 100);
    const resetAt = epoch(quota.resetTime);
    const key = `${left}:${resetAt}`;
    const current = grouped.get(key) ?? { labels: [], left, resetAt };
    current.labels.push(config.label ?? config.modelId ?? "model");
    grouped.set(key, current);
  }
  return [...grouped.values()].map((group) => ({
    agent: "Antigravity",
    account: status.email ?? "default",
    limit: group.labels.length === configs.length
      ? "all models"
      : [
          group.labels.some((label) => label.startsWith("Gemini")) ? "Gemini" : "",
          group.labels.some((label) => label.startsWith("Claude")) ? "Claude" : "",
          group.labels.some((label) => label.startsWith("GPT")) ? "GPT" : "",
        ].filter(Boolean).join(" + ") + ` (${group.labels.length})`,
    used: 100 - group.left,
    resetAt: group.resetAt,
    note: status.planStatus?.planInfo?.planName,
  }));
}

function table(rows: Row[]): string {
  const headers = ["Agent", "Account", "Limit", "Used", "Left", "Reset", "Plan / note"];
  const values = rows.map((row) => [
    row.agent,
    row.account,
    row.limit,
    row.used === null ? "-" : `${Math.round(row.used)}%`,
    row.used === null ? "-" : `${Math.round(100 - row.used)}%`,
    resetText(row.resetAt),
    row.note ?? "",
  ]);
  const widths = headers.map((header, index) => Math.max(header.length, ...values.map((row) => row[index]!.length)));
  const colors = !("NO_COLOR" in process.env)
    && (process.stdout.isTTY || ("FORCE_COLOR" in process.env && process.env.FORCE_COLOR !== "0"));
  const paint = (code: number | string, value: string) => colors ? `\x1b[${code}m${value}\x1b[0m` : value;
  const border = (value: string) => paint(2, value);
  const quotaColor = (used: number | null) => used === null ? 2 : used >= 80 ? 31 : used >= 50 ? 33 : 32;
  const resetColor = (resetAt: number | null) => {
    if (!resetAt) return 2;
    const remaining = resetAt - Date.now();
    if (remaining <= 6 * 60 * 60 * 1000) return 32;
    if (remaining <= 24 * 60 * 60 * 1000) return 33;
    return 31;
  };
  const line = (left: string, middle: string, right: string) => border(left + widths.map((width) => "─".repeat(width + 2)).join(middle) + right);
  const displayRow = (cells: string[], source?: Row) => {
    const styled = cells.map((cell, index) => {
      const padded = cell.padEnd(widths[index]!);
      if (!source) return paint("1;36", padded);
      if (index === 0) return paint(1, padded);
      if (index === 1) return paint(2, padded);
      if (index === 3 || index === 4) return paint(quotaColor(source.used), padded);
      if (index === 5) return paint(resetColor(source.resetAt), padded);
      if (index === 6 && /(?:HTTP \d+|not logged in|no .* returned|open .* rerun)/i.test(source.note ?? "")) return paint(31, padded);
      return padded;
    });
    return border("│") + " " + styled.join(` ${border("│")} `) + " " + border("│");
  };
  return [
    line("┌", "┬", "┐"),
    displayRow(headers),
    line("├", "┼", "┤"),
    ...values.map((value, index) => displayRow(value, rows[index])),
    line("└", "┴", "┘"),
  ].join("\n");
}

async function main() {
  const args = new Set(process.argv.slice(2));
  if (args.has("--help") || args.has("-h")) {
    console.log("Usage: ai-usage [--json]\n\nShow quota use and reset times for installed coding agents.");
    return;
  }
  const rows = (await Promise.all([codexRows(), claudeRows(), kimiRows(), commandCodeRows(), ampRows(), antigravityRows()])).flat();
  if (args.has("--json")) console.log(JSON.stringify(rows, null, 2));
  else console.log(table(rows));
}

main().catch((error) => {
  console.error(`ai-usage: ${(error as Error).message}`);
  process.exit(1);
});
