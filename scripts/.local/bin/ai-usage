#!/usr/bin/env bun

import { execFileSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";

type Row = {
  agent: string;
  account: string;
  pool: string;
  limit: string;
  used: number | null;
  resetAt: number | null;
  note?: string;
};

const home = os.homedir();
const timeoutMs = 10_000;

function activeAccount(provider: "claude" | "codex"): string | null {
  try {
    return fs.readFileSync(path.join(home, ".local/share/ai-accounts", provider, ".active"), "utf8").trim() || null;
  } catch {
    return null;
  }
}

function readJson(file: string): any | null {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return null;
  }
}

function writeJson(file: string, value: unknown) {
  const temporary = `${file}.tmp`;
  fs.writeFileSync(temporary, JSON.stringify(value, null, 2), { mode: 0o600 });
  fs.renameSync(temporary, file);
}

function jwtExpiry(token: string): number {
  try {
    const payload = JSON.parse(Buffer.from(token.split(".")[1]!, "base64url").toString("utf8"));
    return typeof payload.exp === "number" ? payload.exp * 1000 : 0;
  } catch {
    return 0;
  }
}

function jwtExpiresSoon(token: string, expiresAt = 0): boolean {
  const expiry = expiresAt || jwtExpiry(token);
  return !expiry || expiry <= Date.now() + 60_000;
}

async function getJson(url: string, headers: Record<string, string>): Promise<any> {
  const signal = AbortSignal.timeout(timeoutMs);
  const response = await fetch(url, { headers, signal });
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
  return await response.json();
}

function epoch(value: unknown): number | null {
  if (typeof value === "number") return value > 10_000_000_000 ? value : value * 1000;
  if (typeof value !== "string" || !value) return null;
  const parsed = Date.parse(value);
  return Number.isNaN(parsed) ? null : parsed;
}

function percent(value: unknown): number | null {
  const parsed = typeof value === "number" ? value : Number(value);
  return Number.isFinite(parsed) ? Math.max(0, Math.min(100, parsed)) : null;
}

function duration(ms: number): string {
  const minutes = Math.max(0, Math.ceil(ms / 60_000));
  const days = Math.floor(minutes / 1440);
  const hours = Math.floor((minutes % 1440) / 60);
  const mins = minutes % 60;
  if (days) return `${days}d ${hours}h`;
  if (hours) return `${hours}h ${mins}m`;
  return `${mins}m`;
}

function resetText(resetAt: number | null): string {
  if (!resetAt) return "-";
  return `in ${duration(resetAt - Date.now())}`;
}

function windowLabel(seconds: unknown, fallback: string): string {
  const value = Number(seconds);
  if (!Number.isFinite(value) || value <= 0) return fallback;
  if (value % 86400 === 0) return `${value / 86400}d`;
  if (value % 3600 === 0) return `${value / 3600}h`;
  return fallback;
}

async function codexRows(): Promise<Row[]> {
  const nativeProfilesDir = path.join(home, ".local/share/ai-accounts/codex");
  const opencodeProfilesDir = path.join(home, ".local/share/opencode/openai-accounts");
  const nativeFiles = fs.existsSync(nativeProfilesDir)
    ? fs.readdirSync(nativeProfilesDir).filter((name) => name.endsWith(".json")).sort()
    : [];
  const opencodeFiles = fs.existsSync(opencodeProfilesDir)
    ? fs.readdirSync(opencodeProfilesDir).filter((name) => name.endsWith(".json")).sort()
    : [];
  const fallback = path.join(home, ".codex/auth.json");
  const active = activeAccount("codex");
  const profiles: Array<{ name: string; file: string; auth: any; kind: "codex" | "opencode" }> = nativeFiles.map((name) => {
    const profileName = path.basename(name, ".json");
    const file = profileName === active && fs.existsSync(fallback) ? fallback : path.join(nativeProfilesDir, name);
    return { name: profileName, file, auth: readJson(file), kind: "codex" };
  });
  profiles.push(...opencodeFiles.map((name) => ({
    name: path.basename(name, ".json"),
    file: path.join(opencodeProfilesDir, name),
    auth: readJson(path.join(opencodeProfilesDir, name)),
    kind: "opencode" as const,
  })));
  if (!profiles.length && fs.existsSync(fallback)) {
    profiles.push({ name: active ?? "default", file: fallback, auth: readJson(fallback), kind: "codex" });
  }

  const uniqueProfiles: typeof profiles = [];
  const profileByAccount = new Map<string, (typeof profiles)[number]>();
  for (const profile of profiles) {
    const id = profile.kind === "codex" ? profile.auth?.tokens?.account_id : profile.auth?.accountId;
    if (!id) {
      uniqueProfiles.push(profile);
      continue;
    }
    const existing = profileByAccount.get(id);
    const token = profile.kind === "codex" ? profile.auth?.tokens?.access_token : profile.auth?.access;
    const existingToken = existing?.kind === "codex" ? existing.auth?.tokens?.access_token : existing?.auth?.access;
    const expiry = profile.kind === "opencode" && typeof profile.auth?.expires === "number"
      ? profile.auth.expires
      : jwtExpiry(token ?? "");
    const existingExpiry = existing?.kind === "opencode" && typeof existing.auth?.expires === "number"
      ? existing.auth.expires
      : jwtExpiry(existingToken ?? "");
    if (!existing) {
      profileByAccount.set(id, profile);
      uniqueProfiles.push(profile);
    } else if (expiry > existingExpiry) {
      const replacement = { ...profile, name: existing.name };
      profileByAccount.set(id, replacement);
      uniqueProfiles[uniqueProfiles.indexOf(existing)] = replacement;
    }
  }

  const results = await Promise.all(uniqueProfiles.map(async ({ name, file, auth: initialAuth, kind }) => {
    let auth = initialAuth;
    let token = kind === "codex" ? auth?.tokens?.access_token : auth?.access;
    let refreshToken = kind === "codex" ? auth?.tokens?.refresh_token : auth?.refresh;
    const accountId = kind === "codex" ? auth?.tokens?.account_id : auth?.accountId;
    if (!token || !accountId) return [{ agent: "Codex", account: name, pool: "default", limit: "-", used: null, resetAt: null, note: "not logged in" }];
    try {
      if (refreshToken && jwtExpiresSoon(token, kind === "opencode" ? auth?.expires : 0)) {
        const response = await fetch("https://auth.openai.com/oauth/token", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams({
            grant_type: "refresh_token",
            refresh_token: refreshToken,
            client_id: "app_EMoamEEZ73f0CkXaXp7hrann",
          }),
          signal: AbortSignal.timeout(timeoutMs),
        });
        if (!response.ok) throw new Error(`token refresh HTTP ${response.status}`);
        const refreshed: any = await response.json();
        token = refreshed.access_token;
        refreshToken = refreshed.refresh_token ?? refreshToken;
        if (kind === "codex") {
          auth.tokens = { ...auth.tokens, access_token: token, refresh_token: refreshToken, id_token: refreshed.id_token ?? auth.tokens.id_token };
          auth.last_refresh = new Date().toISOString();
        } else {
          auth = { ...auth, access: token, refresh: refreshToken, expires: Date.now() + Number(refreshed.expires_in ?? 0) * 1000 };
        }
        writeJson(file, auth);
      }
      const data = await getJson("https://chatgpt.com/backend-api/wham/usage", {
        Authorization: `Bearer ${token}`,
        "chatgpt-account-id": accountId,
        "OpenAI-Beta": "responses=experimental",
        originator: "codex_cli_rs",
        accept: "application/json",
      });
      const windows = [data.rate_limit?.secondary_window, data.rate_limit?.primary_window].filter(Boolean);
      if (!windows.length) return [{ agent: "Codex", account: name, pool: "default", limit: "-", used: null, resetAt: null, note: data.plan_type ?? "no limits returned" }];
      return windows.map((window: any) => ({
        agent: "Codex",
        account: name,
        pool: "default",
        limit: windowLabel(window.limit_window_seconds, "quota"),
        used: percent(window.used_percent),
        resetAt: epoch(window.reset_at) ?? (window.reset_after_seconds ? Date.now() + Number(window.reset_after_seconds) * 1000 : null),
        note: data.plan_type,
      }));
    } catch (error) {
      return [{ agent: "Codex", account: name, pool: "default", limit: "-", used: null, resetAt: null, note: (error as Error).message }];
    }
  }));
  return results.flat();
}

async function claudeRows(): Promise<Row[]> {
  const profilesDir = path.join(home, ".local/share/ai-accounts/claude");
  const live = path.join(home, ".claude/.credentials.json");
  const active = activeAccount("claude");
  const files = fs.existsSync(profilesDir)
    ? fs.readdirSync(profilesDir).filter((name) => name.endsWith(".json")).sort()
    : [];
  const profiles = files.map((name) => {
    const profileName = path.basename(name, ".json");
    const file = profileName === active && fs.existsSync(live) ? live : path.join(profilesDir, name);
    return { name: profileName, auth: readJson(file)?.claudeAiOauth };
  });
  if (!profiles.length) profiles.push({ name: active ?? "default", auth: readJson(live)?.claudeAiOauth });

  const results = await Promise.all(profiles.map(async ({ name, auth }) => {
    if (!auth?.accessToken) return [{ agent: "Claude", account: name, pool: "default", limit: "-", used: null, resetAt: null, note: "not logged in" }];
    try {
      const data = await getJson("https://api.anthropic.com/api/oauth/usage", {
        Authorization: `Bearer ${auth.accessToken}`,
        "anthropic-beta": "oauth-2025-04-20",
        accept: "application/json",
      });
      const limits: Array<[string, any]> = [
        ["5h", data.five_hour],
        ["7d", data.seven_day],
        ["7d Opus", data.seven_day_opus],
        ["7d Sonnet", data.seven_day_sonnet],
      ];
      return limits.filter(([, value]) => value).map(([label, value]) => ({
        agent: "Claude",
        account: name,
        pool: label.startsWith("7d ") ? label.slice(3) : "default",
        limit: label,
        used: percent(value.utilization),
        resetAt: epoch(value.resets_at),
        note: auth.subscriptionType,
      }));
    } catch (error) {
      return [{ agent: "Claude", account: name, pool: "default", limit: "-", used: null, resetAt: null, note: `${(error as Error).message}; run claude /login` }];
    }
  }));
  return results.flat();
}

async function kimiRows(): Promise<Row[]> {
  const file = path.join(home, ".kimi-code/credentials/kimi-code.json");
  let auth = readJson(file);
  if (!auth?.access_token) return [{ agent: "Kimi", account: "default", pool: "default", limit: "-", used: null, resetAt: null, note: "not logged in" }];
  try {
    if (auth.refresh_token && Number(auth.expires_at) * 1000 <= Date.now() + 60_000) {
      const response = await fetch("https://auth.kimi.com/api/oauth/token", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
          client_id: "17e5f671-d194-4dfb-9706-5516cb48c098",
          grant_type: "refresh_token",
          refresh_token: auth.refresh_token,
        }),
        signal: AbortSignal.timeout(timeoutMs),
      });
      if (!response.ok) throw new Error(`token refresh HTTP ${response.status}`);
      const refreshed: any = await response.json();
      auth = {
        ...auth,
        ...refreshed,
        refresh_token: refreshed.refresh_token ?? auth.refresh_token,
        expires_at: Math.floor(Date.now() / 1000) + Number(refreshed.expires_in ?? 0),
      };
      writeJson(file, auth);
    }
    const data = await getJson("https://api.kimi.com/coding/v1/usages", {
      Authorization: `Bearer ${auth.access_token}`,
      accept: "application/json",
    });
    const rows: Row[] = [];
    const add = (label: string, value: any) => {
      const used = Number(value?.used);
      const cap = Number(value?.limit);
      rows.push({
        agent: "Kimi",
        account: "default",
        pool: "default",
        limit: label,
        used: Number.isFinite(used) && Number.isFinite(cap) && cap > 0 ? percent(used / cap * 100) : null,
        resetAt: epoch(value?.resetTime ?? value?.reset_at),
        note: data.user?.membership?.level?.replace(/^LEVEL_/, "").toLowerCase(),
      });
    };
    if (data.usage) add("7d", data.usage);
    for (const item of data.limits ?? []) {
      const window = item.window ?? {};
      const seconds = Number(window.duration) * (String(window.timeUnit).includes("MINUTE") ? 60 : String(window.timeUnit).includes("HOUR") ? 3600 : 86400);
      add(windowLabel(seconds, "quota"), item.detail ?? item);
    }
    return rows.length ? rows : [{ agent: "Kimi", account: "default", pool: "default", limit: "-", used: null, resetAt: null, note: "no limits returned" }];
  } catch (error) {
    return [{ agent: "Kimi", account: "default", pool: "default", limit: "-", used: null, resetAt: null, note: `${(error as Error).message}; run kimi login` }];
  }
}

async function commandCodeRows(): Promise<Row[]> {
  const auth = readJson(path.join(home, ".commandcode/auth.json"));
  if (!auth?.apiKey) return [{ agent: "CommandCode", account: "default", pool: "default", limit: "-", used: null, resetAt: null, note: "not logged in" }];
  try {
    const data = await getJson("https://api.commandcode.ai/alpha/billing/credits", {
      Authorization: `Bearer ${auth.apiKey}`,
      "Content-Type": "application/json",
      "User-Agent": "command-code-cli",
      "x-command-code-cli-version": "ai-usage",
      "x-command-code-cli-environment": "production",
    });
    const limits = data.windowLimits;
    const rows: Row[] = [];
    for (const [label, value] of [["5h", limits?.fiveHour], ["7d", limits?.weekly]] as Array<[string, any]>) {
      if (!value) continue;
      rows.push({
        agent: "CommandCode",
        account: auth.userName ?? "default",
        pool: "default",
        limit: label,
        used: value.cap > 0 ? percent(value.used / value.cap * 100) : null,
        resetAt: epoch(value.resetAt),
        note: `$${Number(data.credits?.monthlyCredits ?? 0).toFixed(2)} credits`,
      });
    }
    return rows.length ? rows : [{ agent: "CommandCode", account: auth.userName ?? "default", pool: "default", limit: "monthly", used: null, resetAt: null, note: `$${Number(data.credits?.monthlyCredits ?? 0).toFixed(2)} credits` }];
  } catch (error) {
    return [{ agent: "CommandCode", account: auth.userName ?? "default", pool: "default", limit: "-", used: null, resetAt: null, note: (error as Error).message }];
  }
}

async function ampRows(): Promise<Row[]> {
  try {
    const output = execFileSync("amp", ["usage"], { encoding: "utf8", timeout: timeoutMs });
    const account = output.match(/Signed in as\s+([^\s]+)/)?.[1] ?? "default";
    const rows: Row[] = [];
    const daily = output.match(/Amp Free:\s+(\d+)% remaining today/);
    if (daily) rows.push({
      agent: "Amp",
      account,
      pool: "daily",
      limit: "daily",
      used: 100 - Number(daily[1]),
      resetAt: null,
      note: "resets daily",
    });
    const subscription = output.match(/Subscription\s+([^:]+):\s+(\d+)% other usage and (\d+)% orb usage remaining\s+-\s+(.+)/);
    if (subscription) {
      rows.push({ agent: "Amp", account, pool: "subscription", limit: "subscription", used: 100 - Number(subscription[2]), resetAt: null, note: `${subscription[1]}; ${subscription[4]}` });
      rows.push({ agent: "Amp", account, pool: "orbs", limit: "orbs", used: 100 - Number(subscription[3]), resetAt: null, note: subscription[4] });
    }
    const credits = output.match(/Individual credits:\s+\$([\d.]+) remaining/);
    if (credits) rows.push({ agent: "Amp", account, pool: "credits", limit: "credits", used: null, resetAt: null, note: `$${credits[1]} left` });
    return rows.length ? rows : [{ agent: "Amp", account, pool: "default", limit: "-", used: null, resetAt: null, note: "no usage returned" }];
  } catch (error) {
    return [{ agent: "Amp", account: "default", pool: "default", limit: "-", used: null, resetAt: null, note: (error as Error).message }];
  }
}

function agyPorts(): number[] {
  try {
    const output = execFileSync("ss", ["-ltnp"], { encoding: "utf8", timeout: 2_000 });
    const ports = [...output.matchAll(/127\.0\.0\.1:(\d+).*users:\(\(\"agy\"/g)].map((match) => Number(match[1]));
    return [...new Set(ports)];
  } catch {
    return [];
  }
}

async function antigravityRows(): Promise<Row[]> {
  const body = JSON.stringify({ metadata: { ideName: "antigravity", extensionName: "antigravity", locale: "en" } });
  let data: any = null;
  let quotaSummary: any = null;
  for (const port of agyPorts()) {
    for (const scheme of ["http", "https"]) {
      try {
        const response = await fetch(`${scheme}://127.0.0.1:${port}/exa.language_server_pb.LanguageServerService/GetUserStatus`, {
          method: "POST",
          headers: { "Content-Type": "application/json", "Connect-Protocol-Version": "1" },
          body,
          signal: AbortSignal.timeout(1_500),
          ...(scheme === "https" ? { tls: { rejectUnauthorized: false } } as any : {}),
        } as any);
        if (response.ok) {
          data = await response.json();
          const quotaResponse = await fetch(`${scheme}://127.0.0.1:${port}/exa.language_server_pb.LanguageServerService/RetrieveUserQuotaSummary`, {
            method: "POST",
            headers: { "Content-Type": "application/json", "Connect-Protocol-Version": "1" },
            body: JSON.stringify({ forceRefresh: true }),
            signal: AbortSignal.timeout(5_000),
            ...(scheme === "https" ? { tls: { rejectUnauthorized: false } } as any : {}),
          } as any);
          if (quotaResponse.ok) quotaSummary = await quotaResponse.json();
        }
      } catch {}
      if (data) break;
    }
    if (data) break;
  }
  if (!data) return [{ agent: "Antigravity", account: "default", pool: "default", limit: "models", used: null, resetAt: null, note: "open agy, then rerun" }];

  const status = data.userStatus ?? {};
  const groups = quotaSummary?.response?.groups ?? [];
  if (groups.length) {
    return groups.flatMap((group: any) => {
      const groupName = String(group.displayName ?? "models")
        .replace(/ models$/i, "")
        .replace(/ and /gi, " + ");
      return (group.buckets ?? []).map((bucket: any) => ({
        agent: "Antigravity",
        account: status.email ?? "default",
        pool: groupName,
        limit: bucket.window === "weekly" ? "7d" : bucket.window ?? "quota",
        used: typeof bucket.remainingFraction === "number" ? percent((1 - bucket.remainingFraction) * 100) : null,
        resetAt: epoch(bucket.resetTime),
        note: status.planStatus?.planInfo?.planName,
      }));
    });
  }

  const configs = status.cascadeModelConfigData?.clientModelConfigs ?? [];
  const grouped = new Map<string, { labels: string[]; left: number; resetAt: number | null }>();
  for (const config of configs) {
    const quota = config.quotaInfo;
    if (!quota || typeof quota.remainingFraction !== "number") continue;
    const left = Math.round(quota.remainingFraction * 100);
    const resetAt = epoch(quota.resetTime);
    const key = `${left}:${resetAt}`;
    const current = grouped.get(key) ?? { labels: [], left, resetAt };
    current.labels.push(config.label ?? config.modelId ?? "model");
    grouped.set(key, current);
  }
  return [...grouped.values()].map((group) => {
    const label = group.labels.length === configs.length
      ? "all models"
      : [
          group.labels.some((label) => label.startsWith("Gemini")) ? "Gemini" : "",
          group.labels.some((label) => label.startsWith("Claude")) ? "Claude" : "",
          group.labels.some((label) => label.startsWith("GPT")) ? "GPT" : "",
        ].filter(Boolean).join(" + ") + ` (${group.labels.length})`;
    return {
      agent: "Antigravity",
      account: status.email ?? "default",
      pool: label,
      limit: "quota",
      used: 100 - group.left,
      resetAt: group.resetAt,
      note: status.planStatus?.planInfo?.planName,
    };
  });
}

const colors = !("NO_COLOR" in process.env)
  && (process.stdout.isTTY || ("FORCE_COLOR" in process.env && process.env.FORCE_COLOR !== "0"));
const paint = (code: number | string, value: string) => colors ? `\x1b[${code}m${value}\x1b[0m` : value;

const quotaColor = (used: number | null) => used === null ? 2 : used >= 80 ? 31 : used >= 50 ? 33 : 32;
const resetColor = (resetAt: number | null) => {
  if (!resetAt) return 2;
  const remaining = resetAt - Date.now();
  if (remaining <= 6 * 60 * 60 * 1000) return 32;
  if (remaining <= 24 * 60 * 60 * 1000) return 33;
  return 31;
};
const isErrorNote = (note?: string) => /(?:HTTP \d+|not logged in|no .* returned|open .* rerun)/i.test(note ?? "");

const BAR_WIDTH = 12;

function bar(used: number | null): string {
  if (used === null) return paint(2, `${"░".repeat(BAR_WIDTH)}  --`);
  const filled = Math.round((used / 100) * BAR_WIDTH);
  const gauge = "█".repeat(filled) + "░".repeat(BAR_WIDTH - filled);
  return `${paint(quotaColor(used), gauge)} ${paint(quotaColor(used), `${String(Math.round(used)).padStart(3)}%`)}`;
}

function render(pools: Pool[]): string {
  const blocks = pools.map((pool) => {
    const rows = [...pool.rows].sort((a, b) => {
      const left = (row: Row) => row.used === null ? Infinity : 100 - row.used;
      return left(a) - left(b);
    });
    const sharedNote = rows.every((row) => row.note === rows[0]!.note && !isErrorNote(row.note))
      ? rows[0]!.note
      : undefined;
    const effective = pool.left === null ? "" : paint(quotaColor(100 - pool.left), `${Math.round(pool.left)}% usable`);
    const incomplete = pool.usageIncomplete ? paint(33, "usage incomplete") : "";
    const header = [paint(1, poolLabel(pool)), sharedNote ? paint(2, sharedNote) : "", effective, incomplete]
      .filter(Boolean).join(paint(2, " · "));
    const width = Math.max(...rows.map((row) => row.limit.length));
    const lines = rows.map((row) => {
      const parts = [`  ${row.limit.padEnd(width)}  ${bar(row.used)}`];
      if (row.resetAt) parts.push(paint(resetColor(row.resetAt), `resets ${resetText(row.resetAt)}`));
      if (!sharedNote && row.note) parts.push(paint(isErrorNote(row.note) ? 31 : 2, row.note));
      return parts.join(paint(2, "  ·  "));
    });
    return [header, ...lines].join("\n");
  });
  return blocks.join("\n\n");
}

type PoolStatus = "usable" | "blocked" | "unknown";

type Pool = {
  agent: string;
  account: string;
  pool: string;
  rows: Row[];
  // Effective remaining quota: usage draws from every window in the pool,
  // so the binding constraint is the *least* remaining known window.
  left: number | null;
  // True when some quota window reports no usage percentage. `left` then only
  // reflects the known windows; do not treat it as the full picture.
  usageIncomplete: boolean;
  // Earliest known future reset across the pool's windows (the deadline).
  nextResetAt: number | null;
  status: PoolStatus;
};

// Resets within this tolerance are treated as the same deadline group, so a
// few minutes of API timing difference does not reorder pools.
const RESET_GROUP_TOLERANCE_MS = 15 * 60_000;

const resetGroup = (resetAt: number) => Math.round(resetAt / RESET_GROUP_TOLERANCE_MS);

function buildPools(rows: Row[]): Pool[] {
  const groups = new Map<string, Row[]>();
  for (const row of rows) {
    const key = `${row.agent} ${row.account} ${row.pool}`;
    groups.set(key, [...(groups.get(key) ?? []), row]);
  }
  const now = Date.now();
  const pools = [...groups.values()].map((group): Pool => {
    const [{ agent, account, pool }] = group;
    const lefts = group.filter((row) => row.used !== null).map((row) => 100 - row.used!);
    const left = lefts.length ? Math.min(...lefts) : null;
    const usageIncomplete = left !== null && group.some((row) => row.used === null);
    const status: PoolStatus = left === null ? "unknown" : left <= 0 ? "blocked" : "usable";
    const futureResets = (window: Row[]) =>
      window.map((row) => row.resetAt).filter((reset): reset is number => reset !== null && reset > now);
    // For blocked pools the deadline that matters is the binding window's
    // reset (that is when the pool frees), not any earlier non-binding reset.
    const binding = status === "blocked" ? group.filter((row) => row.used !== null && 100 - row.used === left) : [];
    const resets = futureResets(binding.length ? binding : group);
    const nextResetAt = resets.length ? Math.min(...resets) : null;
    return { agent, account, pool, rows: group, left, usageIncomplete, nextResetAt, status };
  });
  return pools.sort(comparePools);
}

const statusRank = (pool: Pool) => pool.status === "usable" ? 0 : pool.status === "blocked" ? 1 : 2;

// Ranking: use quota most at risk of expiring unused first.
// 1. usable before blocked before unknown-usage pools
// 2. usable pools with a known reset before those without
// 3. earliest deadline group (resets within RESET_GROUP_TOLERANCE_MS are one group)
// 4. within a deadline group, least remaining usable quota first; prefer
//    pools with complete usage data when leftovers tie
// 5. deterministic fallback
function comparePools(a: Pool, b: Pool): number {
  if (statusRank(a) !== statusRank(b)) return statusRank(a) - statusRank(b);
  if (a.status === "usable") {
    if ((a.nextResetAt === null) !== (b.nextResetAt === null)) return a.nextResetAt === null ? 1 : -1;
    if (a.nextResetAt !== null && b.nextResetAt !== null) {
      const groupA = resetGroup(a.nextResetAt);
      const groupB = resetGroup(b.nextResetAt);
      if (groupA !== groupB) return groupA - groupB;
    }
    const leftA = a.left ?? Infinity;
    const leftB = b.left ?? Infinity;
    if (leftA !== leftB) return leftA - leftB;
    if (a.usageIncomplete !== b.usageIncomplete) return a.usageIncomplete ? 1 : -1;
  }
  // Blocked pools (and final fallback): whichever frees soonest comes first.
  if (a.nextResetAt !== b.nextResetAt) return (a.nextResetAt ?? Infinity) - (b.nextResetAt ?? Infinity);
  return poolLabel(a).localeCompare(poolLabel(b));
}

function poolLabel(pool: Pool): string {
  const base = pool.account === "default"
    ? pool.agent
    : `${pool.agent} · ${pool.account}`;
  return pool.pool === "default" ? base : `${base} (${pool.pool})`;
}

function suggestion(pools: Pool[]): string {
  const usable = pools.filter((pool) => pool.status === "usable");
  const blocked = pools.filter((pool) => pool.status === "blocked");
  const lines: string[] = [];
  const top = usable[0];
  if (top) {
    const reasons = [`${Math.round(top.left!)}% left`];
    if (top.usageIncomplete) reasons.push("usage incomplete");
    const resetting = top.rows.find((row) => row.resetAt === top.nextResetAt);
    if (top.nextResetAt) {
      reasons.push(`${resetting ? `${resetting.limit} ` : ""}resets ${resetText(top.nextResetAt)}`);
      reasons.push(top.left! < 100 ? "use before reset" : "most urgent usable window");
    } else {
      reasons.push("reset unknown");
    }
    lines.push(paint(32, `→ Use first: ${poolLabel(top)}`));
    lines.push(paint(2, `  ${reasons.join(" · ")}`));
    const rest = usable.slice(1);
    if (rest.length) {
      lines.push(paint(2, "\nNext up:"));
      rest.forEach((pool, index) => {
        const reset = pool.nextResetAt ? `resets ${resetText(pool.nextResetAt)}` : "reset unknown";
        const incomplete = pool.usageIncomplete ? " · usage incomplete" : "";
        lines.push(`  ${paint("1;36", `${index + 2}.`)} ${poolLabel(pool)}${paint(2, `  ·  ${Math.round(pool.left!)}% usable${incomplete} · ${reset}`)}`);
      });
    }
  }
  if (blocked.length) {
    lines.push(paint(2, "\nBlocked:"));
    for (const pool of blocked) {
      const frees = pool.nextResetAt ? `frees ${resetText(pool.nextResetAt)}` : "no known reset";
      lines.push(paint(31, `  ✕ ${poolLabel(pool)}`) + paint(2, `  ·  ${frees}`));
    }
  }
  if (!lines.length) return paint(33, "→ No usage data available");
  if (!top && blocked.length) {
    const soonest = blocked[0]!;
    lines.unshift(paint(33, `→ All pools exhausted; ${poolLabel(soonest)} frees first ${soonest.nextResetAt ? resetText(soonest.nextResetAt) : "(reset unknown)"}`));
  }
  return lines.join("\n");
}

async function main() {
  const args = new Set(process.argv.slice(2));
  if (args.has("--help") || args.has("-h")) {
    console.log("Usage: ai-usage [--json]\n\nShow quota use for installed coding agents, ranked by which pool to spend first.");
    return;
  }
  const rows = (await Promise.all([codexRows(), claudeRows(), kimiRows(), commandCodeRows(), ampRows(), antigravityRows()])).flat();
  const pools = buildPools(rows);
  if (args.has("--json")) console.log(JSON.stringify(pools.map(({ rows: poolRows, ...pool }) => ({ ...pool, rows: poolRows })), null, 2));
  else console.log(`${suggestion(pools)}\n\n${render(pools)}`);
}

main().catch((error) => {
  console.error(`ai-usage: ${(error as Error).message}`);
  process.exit(1);
});
