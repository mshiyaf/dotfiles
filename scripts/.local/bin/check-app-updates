#!/usr/bin/env bash
#
# check-app-updates - version check for apps installed outside pacman (AppImage /
# hand-extracted .deb, living under /opt or /usr/lib), plus command-code (technically
# a pacman package, but one AUR can never legitimately own - see manual-apps.sh).
# pacman never sees these, so `pacman -Syu` can't tell you they're stale - this can.
#
# Read-only: it only reports what's outdated. Run `update-apps` to actually update.
#
# Usage:
#   check-app-updates          Check all known apps
#   check-app-updates t3code   Check a single app (t3code|chatgpt|command-code|claude-desktop,
#                              a Craft app: photocraft|pdfcraft|wordcraft|deckcraft|gridcraft,
#                              or a self-updating tool: claude|codex|amp|agy|herdr|opencode|
#                              opencode2|mise|rustup|uv)
#
# Exit: 0 if everything is current, 1 if anything is outdated or unknown.

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
# shellcheck source=../share/manual-apps.sh
source "$SCRIPT_DIR/../share/manual-apps.sh"

ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m⚠ %s\033[0m\n' "$*"; }
err()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; }

STATUS=0

check() {
  local name="$1" local_fn="$2" remote_fn="$3" hint="$4"
  local installed latest

  # The app name is passed through for the shared Craft app functions.
  installed=$("$local_fn" "$name" 2>/dev/null || true)
  latest=$("$remote_fn" "$name" 2>/dev/null || true)

  if [ -z "$installed" ]; then
    warn "$name: not installed (or version unreadable) - skipping"
    return
  fi
  if [ -z "$latest" ]; then
    warn "$name: installed $installed, couldn't reach upstream to check latest"
    STATUS=1
    return
  fi
  if [ "$installed" = "$latest" ]; then
    ok "$name: $installed (up to date)"
  else
    warn "$name: $installed -> $latest available (run: update-apps $name)"
    printf '    %s\n' "$hint"
    STATUS=1
  fi
}

# Self-updating tools: only reported here; `update-apps` runs their updaters.
check_tool() {
  local key="$1" state installed detail
  if ! tool_installed "$key"; then
    warn "$key: not installed - skipping"
    return
  fi
  IFS=$'\t' read -r state installed detail < <(tool_status "$key")
  case "$state" in
    current) ok "$key: $installed (up to date)" ;;
    outdated)
      # Toolchains list their outdated components instead of one version.
      if [ -n "${TOOL_OUTDATED[$key]+x}" ]; then
        warn "$key: $detail (run: update-apps $key)"
      else
        warn "$key: $installed -> $detail (run: update-apps $key)"
      fi
      STATUS=1
      ;;
    *)
      warn "$key: $installed ($detail)"
      [ "$detail" = "no public version check" ] || STATUS=1
      ;;
  esac
}

apps=("${1:-all}")
[ "${apps[0]}" = all ] && apps=(t3code chatgpt command-code claude-desktop "${CRAFT_APPS[@]}" "${TOOL_ORDER[@]}")

for app in "${apps[@]}"; do
  case "$app" in
    t3code)
      check "t3code" t3code_local t3code_remote \
        "download: https://github.com/pingdotgg/t3code/releases/latest"
      ;;
    chatgpt)
      check "chatgpt" chatgpt_local chatgpt_remote \
        "download: $CHATGPT_DEB_URL"
      ;;
    command-code)
      check "command-code" command_code_local command_code_remote \
        "download: https://commandcode.ai/desktop (do NOT 'paru -S command-code' - see manual-apps.sh)"
      ;;
    claude-desktop)
      check "claude-desktop" claude_desktop_local claude_desktop_remote \
        "download: https://code.claude.com/docs/en/desktop-linux (no AUR package - manual .deb only)"
      ;;
    *)
      if is_craft_app "$app"; then
        check "$app" craft_local craft_remote \
          "download: https://github.com/storytold/$app/releases/latest"
      elif [ -n "${TOOL_UPDATE[$app]+x}" ]; then
        check_tool "$app"
      else
        err "unknown app: $app (expected t3code|chatgpt|command-code|claude-desktop|$(IFS='|'; echo "${CRAFT_APPS[*]}|${TOOL_ORDER[*]}"))"
        exit 2
      fi
      ;;
  esac
done

exit $STATUS
