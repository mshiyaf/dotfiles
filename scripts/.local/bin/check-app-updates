#!/usr/bin/env bash
#
# check-app-updates - version check for apps installed outside pacman (AppImage /
# hand-extracted .deb, living under /opt or /usr/lib), plus command-code (technically
# a pacman package, but one AUR can never legitimately own - see manual-apps.sh).
# pacman never sees these, so `pacman -Syu` can't tell you they're stale - this can.
#
# Read-only: it only reports what's outdated. Run `update-apps` to actually update.
#
# Usage:
#   check-app-updates          Check all known apps
#   check-app-updates cursor   Check a single app (cursor|t3code|chatgpt|command-code|claude-desktop)
#
# Exit: 0 if everything is current, 1 if anything is outdated or unknown.

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
# shellcheck source=../share/manual-apps.sh
source "$SCRIPT_DIR/../share/manual-apps.sh"

ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m⚠ %s\033[0m\n' "$*"; }
err()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; }

STATUS=0

check() {
  local name="$1" local_fn="$2" remote_fn="$3" hint="$4"
  local installed latest

  installed=$("$local_fn" 2>/dev/null || true)
  latest=$("$remote_fn" 2>/dev/null || true)

  if [ -z "$installed" ]; then
    warn "$name: not installed (or version unreadable) - skipping"
    return
  fi
  if [ -z "$latest" ]; then
    warn "$name: installed $installed, couldn't reach upstream to check latest"
    STATUS=1
    return
  fi
  if [ "$installed" = "$latest" ]; then
    ok "$name: $installed (up to date)"
  else
    warn "$name: $installed -> $latest available (run: update-apps $name)"
    printf '    %s\n' "$hint"
    STATUS=1
  fi
}

apps=("${1:-all}")
[ "${apps[0]}" = all ] && apps=(cursor t3code chatgpt command-code claude-desktop)

for app in "${apps[@]}"; do
  case "$app" in
    cursor)
      check "cursor" cursor_local cursor_remote \
        "download: https://cursor.com/api/download?platform=linux-x64&releaseTrack=stable"
      ;;
    t3code)
      check "t3code" t3code_local t3code_remote \
        "download: https://github.com/pingdotgg/t3code/releases/latest"
      ;;
    chatgpt)
      check "chatgpt" chatgpt_local chatgpt_remote \
        "download: $CHATGPT_DEB_URL"
      ;;
    command-code)
      check "command-code" command_code_local command_code_remote \
        "download: https://commandcode.ai/desktop (do NOT 'paru -S command-code' - see manual-apps.sh)"
      ;;
    claude-desktop)
      check "claude-desktop" claude_desktop_local claude_desktop_remote \
        "download: https://code.claude.com/docs/en/desktop-linux (no AUR package - manual .deb only)"
      ;;
    *)
      err "unknown app: $app (expected cursor|t3code|chatgpt|command-code|claude-desktop)"
      exit 2
      ;;
  esac
done

exit $STATUS
