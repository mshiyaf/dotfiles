#!/usr/bin/env bun

import fs from "node:fs";
import path from "node:path";

type CodexModel = string | { model: string; reasoning_effort?: string };
type ModelMap = Record<string, { opencode: string; claude: string; codex: CodexModel; antigravity?: string }>;

const EDIT_CAPABLE = new Set(["debugger", "tester", "docs-writer", "pr-writer"]);
const EDIT_DENY = new Set([
  "reviewer",
  "security-reviewer",
  "critic",
  "architect",
  "refactor-planner",
  "researcher",
]);
const CLAUDE_READ_ONLY_TOOLS = "Read, Grep, Glob, Bash";
const CLAUDE_EDIT_TOOLS = "Read, Grep, Glob, Bash, Edit, Write";

const repo = findRepoRoot(process.cwd());
const check = process.argv.includes("--check");

function findRepoRoot(start: string): string {
  let dir = start;
  while (true) {
    if (fs.existsSync(path.join(dir, "agents")) && fs.existsSync(path.join(dir, "opencode"))) return dir;
    const parent = path.dirname(dir);
    if (parent === dir) throw new Error("Could not find dotfiles repo root");
    dir = parent;
  }
}

function parseAgent(file: string): { description: string; body: string } {
  const raw = fs.readFileSync(file, "utf8");
  const match = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
  if (!match) throw new Error(`Missing frontmatter: ${file}`);
  const description = match[1].match(/^description:\s*(.*)$/m)?.[1]?.trim();
  if (!description) throw new Error(`Missing description: ${file}`);
  return { description, body: match[2].trimEnd() + "\n" };
}

function yamlQuote(value: string): string {
  return JSON.stringify(value);
}

function tomlString(value: string): string {
  return JSON.stringify(value);
}

function tomlMultiline(value: string): string {
  return `'''\n${value.replace(/'''/g, "''\\''")}'''`;
}

function ensureDir(dir: string) {
  fs.mkdirSync(dir, { recursive: true });
}

function isEmptyDirectoryTree(dir: string): boolean {
  return fs
    .readdirSync(dir, { withFileTypes: true })
    .every((entry) => entry.isDirectory() && isEmptyDirectoryTree(path.join(dir, entry.name)));
}

function removeLegacyCodexSkillLinks(dir: string, legacySource: string, root = dir) {
  if (!fs.existsSync(dir)) return;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if (dir === root && entry.name === ".system") continue;
    const file = path.join(dir, entry.name);
    if (entry.isDirectory()) removeLegacyCodexSkillLinks(file, legacySource, root);
    else if (entry.isSymbolicLink()) {
      const resolvedTarget = path.resolve(dir, fs.readlinkSync(file));
      if (resolvedTarget.startsWith(`${legacySource}${path.sep}`)) fs.unlinkSync(file);
    }
  }
  if (dir !== root && fs.readdirSync(dir).length === 0) fs.rmdirSync(dir);
}

function writeOrCheck(file: string, content: string): boolean {
  if (check) {
    const current = fs.existsSync(file) ? fs.readFileSync(file, "utf8") : "";
    if (current !== content) {
      console.error(`stale: ${path.relative(repo, file)}`);
      return false;
    }
    return true;
  }
  fs.writeFileSync(file, content);
  return true;
}

function syncCodexSkillLinks(sourceDir: string, targetDir: string) {
  ensureDir(targetDir);
  const expected = new Map(
    fs
      .readdirSync(sourceDir, { withFileTypes: true })
      .filter((entry) => entry.isDirectory() && !entry.name.startsWith("."))
      .map((entry) => [entry.name, path.relative(targetDir, path.join(sourceDir, entry.name))]),
  );

  for (const entry of fs.readdirSync(targetDir, { withFileTypes: true })) {
    if (!entry.isSymbolicLink() || expected.has(entry.name)) continue;
    const file = path.join(targetDir, entry.name);
    const resolvedTarget = path.resolve(targetDir, fs.readlinkSync(file));
    if (path.dirname(resolvedTarget) === sourceDir) fs.unlinkSync(file);
  }

  for (const [name, linkTarget] of expected) {
    const file = path.join(targetDir, name);
    let currentTarget: string | undefined;
    try {
      currentTarget = fs.readlinkSync(file);
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code !== "ENOENT" && (error as NodeJS.ErrnoException).code !== "EINVAL") {
        throw error;
      }
    }

    if (currentTarget !== undefined && path.resolve(targetDir, currentTarget) === path.resolve(targetDir, linkTarget)) {
      continue;
    }
    if (currentTarget !== undefined) {
      throw new Error(`Refusing to replace existing Codex skill: ${file}`);
    }
    if (fs.existsSync(file)) {
      const entry = fs.lstatSync(file);
      if (entry.isDirectory() && isEmptyDirectoryTree(file)) fs.rmSync(file, { recursive: true });
      else throw new Error(`Refusing to replace existing Codex skill: ${file}`);
    }
    fs.symlinkSync(linkTarget, file, "dir");
  }
}

const modelsPath = path.join(repo, "agents", "models.json");
const models = JSON.parse(fs.readFileSync(modelsPath, "utf8")) as ModelMap;
const sourceDir = path.join(repo, "opencode", ".config", "opencode", "agents");
const claudeDir = path.join(repo, "agents", ".claude", "agents");
const codexDir = path.join(repo, "agents", ".codex", "agents");
const sharedSkillsDir = path.join(repo, "agents", ".config", "opencode", "skills");

ensureDir(claudeDir);
ensureDir(codexDir);

let ok = true;
for (const role of Object.keys(models).sort()) {
  const source = path.join(sourceDir, `${role}.md`);
  if (!fs.existsSync(source)) throw new Error(`Missing source agent: ${source}`);
  const { description, body } = parseAgent(source);
  const generated = `# GENERATED by agents-sync - edit opencode/.config/opencode/agents/${role}.md instead`;
  const readOnly = EDIT_DENY.has(role);
  if (!readOnly && !EDIT_CAPABLE.has(role)) throw new Error(`Role is neither edit-deny nor edit-capable: ${role}`);

  const claudeBody = readOnly ? `${body}\nRead-only role: do not edit files.\n` : body;
  const claude = `${generated}\n---\nname: ${role}\ndescription: ${yamlQuote(description)}\nmodel: ${models[role].claude}\ntools: ${readOnly ? CLAUDE_READ_ONLY_TOOLS : CLAUDE_EDIT_TOOLS}\n---\n${claudeBody}`;
  ok = writeOrCheck(path.join(claudeDir, `${role}.md`), claude) && ok;

  const codexConfig = models[role].codex;
  const codexModel = typeof codexConfig === "string" ? codexConfig : codexConfig.model;
  const codexReasoningEffort = typeof codexConfig === "string" ? undefined : codexConfig.reasoning_effort;
  const codexEffortLine = codexReasoningEffort
    ? `model_reasoning_effort = ${tomlString(codexReasoningEffort)}\n`
    : "";
  const codex = `${generated}\nname = ${tomlString(role)}\ndescription = ${tomlString(description)}\ndeveloper_instructions = ${tomlMultiline(body)}\nmodel = ${tomlString(codexModel)}\n${codexEffortLine}sandbox_mode = ${tomlString(readOnly ? "read-only" : "workspace-write")}\n`;
  ok = writeOrCheck(path.join(codexDir, `${role}.toml`), codex) && ok;
}

if (!check) {
  const home = process.env.HOME;
  if (!home) throw new Error("HOME is not set");
  removeLegacyCodexSkillLinks(
    path.join(home, ".codex", "skills"),
    path.join(repo, "agents", ".codex", "skills"),
  );
  syncCodexSkillLinks(sharedSkillsDir, path.join(home, ".agents", "skills"));
}

process.exit(ok ? 0 : 1);
