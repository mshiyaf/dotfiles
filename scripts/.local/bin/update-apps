#!/usr/bin/env bash
#
# update-apps - interactive updater for the apps check-app-updates tracks (installed
# outside pacman, or command-code which pacman can never legitimately own - see
# manual-apps.sh). Downloads the real upstream artifact and installs it the same
# way it was installed originally: AppImages replaced in place, .deb packages
# extracted by hand and copied onto the filesystem (never via debtap/pacman/paru -
# that's the whole reason these need this script).
#
# It also drives the self-updating CLIs and toolchains that live outside pacman
# (claude, codex, amp, agy, herdr, opencode, opencode2, mise, rustup, uv) by
# running each one's own updater, so one command covers everything paru doesn't.
#
# Usage:
#   update-apps                 Interactive picker (fzf, multi-select with Tab)
#   update-apps t3code claude   Update specific apps/tools directly, no picker
#   update-apps --all           Update every outdated app and tool
#
# Installs under /opt and /usr need root; you'll be prompted for sudo per app as
# needed. Requires: fzf, curl, python3, ar (binutils), tar.

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
# shellcheck source=../share/manual-apps.sh
source "$SCRIPT_DIR/../share/manual-apps.sh"

info() { printf '\033[1;34m▸ %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m⚠ %s\033[0m\n' "$*"; }
err()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; }

# --- shared install helpers -------------------------------------------------

# Downloads an AppImage and installs it in place of an existing one (always sudo:
# t3code's /opt dir is root-owned).
install_appimage() {
  local url="$1" dest="$2"
  local tmp
  tmp=$(mktemp)
  info "Downloading $(basename "$dest")..."
  curl -fL --progress-bar -o "$tmp" "$url"
  chmod +x "$tmp"
  sudo install -Dm755 "$tmp" "$dest"
  rm -f "$tmp"
}

# Downloads a .deb and merges its data tree directly onto /, matching how these
# were installed originally (debtap/namcap crashes on their large Electron
# binaries - see the check-app-updates README section for why).
install_deb() {
  local url="$1"
  local tmp
  tmp=$(mktemp -d)
  info "Downloading $(basename "$url")..."
  curl -fL --progress-bar -o "$tmp/pkg.deb" "$url"
  (cd "$tmp" && ar x pkg.deb)
  info "Installing (sudo)..."
  # .deb data tarballs record root:root ownership and real permissions (setuid
  # bits like chrome-sandbox's 4755 included) - extracting as root instead of
  # the invoking user is what actually applies that metadata, rather than
  # silently dropping it to the current user. `-C /` merges it straight onto
  # the filesystem, same as dpkg itself would.
  sudo tar --same-owner -xpf "$tmp"/data.tar.* -C /
  sudo update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
  sudo gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
  rm -rf "$tmp"
}

# --- per-app update ----------------------------------------------------------

update_t3code() {
  local info_line ver url
  info_line=$(t3code_remote_info) || { err "t3code: couldn't reach GitHub"; return 1; }
  ver=$(cut -f1 <<<"$info_line"); url=$(cut -f2 <<<"$info_line")
  install_appimage "$url" "/opt/t3code/T3Code.AppImage"
  sudo sed -i "s/X-AppImage-Version=.*/X-AppImage-Version=$ver/" \
    "$HOME/.local/share/applications/t3code.desktop"
  ok "t3code updated to $ver"
}

update_chatgpt() {
  local ver
  ver=$(chatgpt_remote) || { err "chatgpt: couldn't reach OpenAI's repo index"; return 1; }
  [ -n "$ver" ] || { err "chatgpt: couldn't determine latest version"; return 1; }
  install_deb "$CHATGPT_DEB_URL"
  mkdir -p "$(dirname "$CHATGPT_VERSION_MARKER")"
  echo "$ver" > "$CHATGPT_VERSION_MARKER"
  ok "chatgpt updated to $ver"
}

update_command_code() {
  local info_line ver url
  info_line=$(command_code_remote_info) || { err "command-code: couldn't reach GitHub"; return 1; }
  ver=$(cut -f1 <<<"$info_line"); url=$(cut -f2 <<<"$info_line")
  install_deb "$url"
  ok "command-code updated to $ver"
  warn "note: pacman's local db still shows the old version (see manual-apps.sh) - cosmetic only, harmless."
}

update_claude_desktop() {
  local info_line ver url
  info_line=$(claude_desktop_remote_info) || { err "claude-desktop: couldn't reach downloads.claude.ai"; return 1; }
  ver=$(cut -f1 <<<"$info_line"); url=$(cut -f2 <<<"$info_line")
  install_deb "$url"
  # Electron/Chromium's password-store backend detection keys off
  # XDG_CURRENT_DESKTOP and doesn't recognize niri (or most tiling WMs), so it
  # skips a real, working Secret Service and falls back to "won't be saved."
  # install_deb re-copies this .desktop from the .deb's own contents on every
  # update, so this patch has to be reapplied every time, not just once.
  sudo sed -i 's/^Exec=claude-desktop/Exec=claude-desktop --password-store=gnome-libsecret/' \
    /usr/share/applications/com.anthropic.Claude.desktop
  mkdir -p "$(dirname "$CLAUDE_DESKTOP_VERSION_MARKER")"
  echo "$ver" > "$CLAUDE_DESKTOP_VERSION_MARKER"
  ok "claude-desktop updated to $ver"
}

# Installs/updates any Craft app ($1 = app id) from its GitHub release: the
# AppImage is verified against the release's SHA256SUMS.txt, then swapped in with
# an atomic rename (safe while the app is running), and its bundled .desktop and
# icon are installed with Exec pointed at the AppImage. Per-user, no sudo.
update_craft() {
  local app="$1" info_line ver url sums_url tmp file expected
  info_line=$(craft_remote_info "$app") || true
  [ -n "$info_line" ] || { err "$app: couldn't reach GitHub"; return 1; }
  IFS=$'\t' read -r ver url sums_url <<<"$info_line"
  file=$(basename "$url")
  tmp=$(mktemp -d)
  info "Downloading $file..."
  curl -fL --progress-bar -o "$tmp/$file" "$url"
  expected=$(curl -fsSL "$sums_url" | awk -v f="$file" '$2 == f || $2 == "*" f {print $1}')
  if [ -z "$expected" ] || [ "$(sha256sum "$tmp/$file" | cut -d' ' -f1)" != "$expected" ]; then
    rm -rf "$tmp"
    err "$app: checksum missing or mismatched for $file - not installing"
    return 1
  fi
  chmod +x "$tmp/$file"
  (cd "$tmp" && "./$file" --appimage-extract "ai.storyteller.$app.desktop" >/dev/null &&
    "./$file" --appimage-extract "ai.storyteller.$app.png" >/dev/null)
  mkdir -p "$CRAFT_DIR"
  install -m755 "$tmp/$file" "$CRAFT_DIR/.$app.AppImage.new"
  mv -f "$CRAFT_DIR/.$app.AppImage.new" "$CRAFT_DIR/$app.AppImage"
  install -Dm644 "$tmp/squashfs-root/ai.storyteller.$app.png" \
    "$HOME/.local/share/icons/hicolor/256x256/apps/ai.storyteller.$app.png"
  mkdir -p "$HOME/.local/share/applications"
  sed -e "s|^Exec=[^ ]*|Exec=\"$CRAFT_DIR/$app.AppImage\"|" -e '/^TryExec=/d' \
    "$tmp/squashfs-root/ai.storyteller.$app.desktop" \
    > "$HOME/.local/share/applications/ai.storyteller.$app.desktop"
  update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
  rm -rf "$tmp"
  ok "$app updated to $ver"
}

# --- self-updating tools -----------------------------------------------------
#
# Defined in manual-apps.sh (TOOL_*, tool_status); update-apps runs each one's
# own updater (all under $HOME, no sudo).

update_tool() {
  local key="$1"
  tool_installed "$key" || { err "$key: $(tool_bin "$key") not found on PATH"; return 1; }
  bash -c "${TOOL_UPDATE[$key]}"
  ok "$key: $(bash -c "${TOOL_VERSION[$key]}" 2>/dev/null | head -1)"
}

# --- driver ------------------------------------------------------------------

declare -A LABEL=(
  [t3code]="T3 Code"
  [chatgpt]="ChatGPT"
  [command-code]="Command Code"
  [claude-desktop]="Claude Desktop"
)
declare -A LOCAL_FN=(
  [t3code]=t3code_local [chatgpt]=chatgpt_local
  [command-code]=command_code_local [claude-desktop]=claude_desktop_local
)
declare -A REMOTE_FN=(
  [t3code]=t3code_remote [chatgpt]=chatgpt_remote
  [command-code]=command_code_remote [claude-desktop]=claude_desktop_remote
)
declare -A UPDATE_FN=(
  [t3code]=update_t3code [chatgpt]=update_chatgpt
  [command-code]=update_command_code [claude-desktop]=update_claude_desktop
)
ORDER=(t3code chatgpt command-code claude-desktop)

# Craft apps share one set of functions, each taking the app id - which is why
# every LOCAL_FN/REMOTE_FN/UPDATE_FN call below passes "$key" (the per-app
# functions above simply ignore it).
for app in "${CRAFT_APPS[@]}"; do
  LABEL[$app]=${CRAFT_LABEL[$app]}
  LOCAL_FN[$app]=craft_local REMOTE_FN[$app]=craft_remote UPDATE_FN[$app]=update_craft
  ORDER+=("$app")
done

menu_line() {
  local key="$1" installed latest
  installed=$("${LOCAL_FN[$key]}" "$key" 2>/dev/null || echo "?")
  latest=$("${REMOTE_FN[$key]}" "$key" 2>/dev/null || echo "?")
  if [ "$installed" = "$latest" ]; then
    printf '%s\t%s  (%s, up to date)\n' "$key" "${LABEL[$key]}" "$installed"
  else
    printf '%s\t%s  (%s -> %s)\n' "$key" "${LABEL[$key]}" "$installed" "$latest"
  fi
}

tool_menu_line() {
  local key="$1" state installed detail
  tool_installed "$key" || return 0
  IFS=$'\t' read -r state installed detail < <(tool_status "$key")
  case "$state" in
    current) printf '%s\t%s  (%s, up to date)\n' "$key" "${TOOL_LABEL[$key]}" "$installed" ;;
    outdated)
      if [ -n "${TOOL_OUTDATED[$key]+x}" ]; then
        printf '%s\t%s  (%s)\n' "$key" "${TOOL_LABEL[$key]}" "$detail"
      else
        printf '%s\t%s  (%s -> %s)\n' "$key" "${TOOL_LABEL[$key]}" "$installed" "$detail"
      fi
      ;;
    *) printf '%s\t%s  (%s, %s)\n' "$key" "${TOOL_LABEL[$key]}" "${installed:-?}" "$detail" ;;
  esac
}

run_update() {
  local key="$1"
  if [ -n "${UPDATE_FN[$key]+x}" ]; then
    info "Updating ${LABEL[$key]}..."
    "${UPDATE_FN[$key]}" "$key"
  elif [ -n "${TOOL_UPDATE[$key]+x}" ]; then
    info "Updating ${TOOL_LABEL[$key]}..."
    update_tool "$key"
  else
    err "unknown app: $key (expected: ${ORDER[*]} ${TOOL_ORDER[*]})"
    return 2
  fi
}

selected=()

if [ "${1:-}" = "--all" ]; then
  for key in "${ORDER[@]}"; do
    installed=$("${LOCAL_FN[$key]}" "$key" 2>/dev/null || echo "")
    latest=$("${REMOTE_FN[$key]}" "$key" 2>/dev/null || echo "")
    [ -n "$installed" ] && [ -n "$latest" ] && [ "$installed" != "$latest" ] && selected+=("$key")
  done
  # Outdated tools, plus those whose status can't be checked (their updater is
  # a no-op when already current).
  for key in "${TOOL_ORDER[@]}"; do
    tool_installed "$key" || continue
    [ "$(tool_status "$key" | cut -f1)" = current ] || selected+=("$key")
  done
  if [ "${#selected[@]}" -eq 0 ]; then
    ok "everything is already up to date"
    exit 0
  fi
elif [ "$#" -gt 0 ]; then
  selected=("$@")
else
  command -v fzf >/dev/null 2>&1 || { err "fzf not found - required for the interactive picker"; exit 1; }
  info "Checking current versions..."
  mapfile -t chosen < <(
    { for key in "${ORDER[@]}"; do menu_line "$key"; done
      for key in "${TOOL_ORDER[@]}"; do tool_menu_line "$key"; done; } |
      fzf --multi --delimiter='\t' --with-nth=2.. \
          --header='Tab: select multiple | Enter: update selected | Esc: cancel' |
      cut -f1
  )
  selected=("${chosen[@]}")
  if [ "${#selected[@]}" -eq 0 ]; then
    info "nothing selected"
    exit 0
  fi
fi

FAILED=0
for key in "${selected[@]}"; do
  run_update "$key" || FAILED=1
done

exit $FAILED
